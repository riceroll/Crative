{%- comment -%}
CRATIVE — IMAGE SLIDER (ratio-safe) — v2
• Removes hard edge gutters (no extra left/right gap)
• Adds section background color control
• Adds left/right arrow indicators (with optional click if theme binds data-carousel-prev/next)
{%- endcomment -%}

<section id="img-slider-{{ section.id }}"
  class="section-carousel {{ section.settings.bg }} {% if section.settings.title == blank %}section-without-title{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="section-carousel"
  style="--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px; background: {{ section.settings.section_bg }};">

  {%- comment -%} Progress bar flags {%- endcomment -%}
  {% assign show_mobile_bar = false %}
  {% assign show_desktop_bar = false %}
  {% if section.settings.progress_bar == 'mobile' %}{% assign show_mobile_bar = true %}{% endif %}
  {% if section.settings.progress_bar == 'desktop' %}{% assign show_desktop_bar = true %}{% endif %}
  {% if section.settings.progress_bar == 'both' %}{% assign show_mobile_bar = true %}{% assign show_desktop_bar = true %}{% endif %}

  {%- comment -%} Map ratio labels to "w / h" strings (desktop & mobile) {%- endcomment -%}
  {% assign ratio_value = '4 / 3' %}
  {% case section.settings.ratio %}
    {% when '1:1' %}{% assign ratio_value = '1 / 1' %}
    {% when '4:3' %}{% assign ratio_value = '4 / 3' %}
    {% when '7:5' %}{% assign ratio_value = '7 / 5' %}
    {% when '16:9' %}{% assign ratio_value = '16 / 9' %}
  {% endcase %}

  {% assign mobile_ratio_value = '4 / 3' %}
  {% case section.settings.ratio_mobile %}
    {% when '1:1' %}{% assign mobile_ratio_value = '1 / 1' %}
    {% when '4:3' %}{% assign mobile_ratio_value = '4 / 3' %}
    {% when '7:5' %}{% assign mobile_ratio_value = '7 / 5' %}
    {% when '16:9' %}{% assign mobile_ratio_value = '16 / 9' %}
  {% endcase %}

  <div
    class="{{ section.settings.width }} {{ section.settings.align_text }} section-padding"
    data-wrapper
    style="max-width:{% if section.settings.max_width_px > 0 %}{{ section.settings.max_width_px }}px{% else %}none{% endif %}; margin-inline:auto; position:relative;">

    <flickity-carousel>
      {% if section.settings.title != blank %}
        <div class="section-carousel__header">
          <p class="kicker-flourished">{{ section.settings.title | escape }}</p>
        </div>
      {% endif %}

      <div
        data-carousel
        data-grid
        data-grid-large
        data-grid-medium
        data-grid-small
        {% if show_desktop_bar %}data-carousel-progress{% endif %}
        {% if show_mobile_bar %}data-custom-scrollbar-items class="flickity-disabled-mobile"{% endif %}
        style="
          --grid-large-items: {{ section.settings.grid_large }};
          --grid-medium-items: {{ section.settings.grid_medium }};
          --grid-small-items: {{ section.settings.grid_mobile }};
          --gap-desktop: {{ section.settings.item_gap_desktop }}px;
          --gap-mobile: {{ section.settings.item_gap_mobile }}px;
        "
        data-options='{"watchCSS": {{ show_mobile_bar }}}'>

        {% for block in section.blocks %}
          {% assign img = block.settings.image %}

          {%- comment -%} Per-slide ratio (default to section values, allow override) {%- endcomment -%}
          {% assign slide_ratio = ratio_value %}
          {% assign slide_ratio_mobile = mobile_ratio_value %}
          {% if block.settings.use_custom_ratio %}
            {% case block.settings.custom_ratio %}
              {% when '1:1' %}{% assign slide_ratio = '1 / 1' %}
              {% when '4:3' %}{% assign slide_ratio = '4 / 3' %}
              {% when '7:5' %}{% assign slide_ratio = '7 / 5' %}
              {% when '16:9' %}{% assign slide_ratio = '16 / 9' %}
            {% endcase %}
            {% case block.settings.custom_ratio_mobile %}
              {% when '1:1' %}{% assign slide_ratio_mobile = '1 / 1' %}
              {% when '4:3' %}{% assign slide_ratio_mobile = '4 / 3' %}
              {% when '7:5' %}{% assign slide_ratio_mobile = '7 / 5' %}
              {% when '16:9' %}{% assign slide_ratio_mobile = '16 / 9' %}
            {% endcase %}
          {% endif %}

          <div class="slide-item" data-carousel-slide data-item {{ block.shopify_attributes }}>
            <figure class="cis__card">
              <div class="cis__media"
                  style="--cis-ratio: {{ slide_ratio }}; --cis-ratio-mobile: {{ slide_ratio_mobile }};
                         --cis-radius: {{ section.settings.image_radius }}px;
                         --cis-maxh: {% if section.settings.max_height_px > 0 %}{{ section.settings.max_height_px }}px{% else %}none{% endif %};
                         background: {{ section.settings.card_bg }};">

                {% if img != blank %}
                  {% assign alt_txt = block.settings.alt | default: img.alt | default: block.settings.caption | default: 'Slide image' %}
                  {% capture sizes_attr %}(min-width:1200px) calc(100vw / {{ section.settings.grid_large }}), (min-width:750px) calc(100vw / {{ section.settings.grid_medium }}), 90vw{% endcapture %}
                  
                  <div class="cis__img-container" {% if block.settings.link != blank %}data-iframe-url="{{ block.settings.link }}"{% endif %}>
                    {{ img
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        sizes: sizes_attr,
                        widths: '600,900,1200,1600,2000',
                        alt: alt_txt,
                        class: 'cis__img'
                    }}
                  </div>
                {% else %}
                  <div class="cis__placeholder"></div>
                {% endif %}

                {%- comment -%}
                  MODIFIED CAPTION:
                  • Renders inside .cis__media so positioning anchors to the image.
                  • Uses SECTION settings (not block settings) for position/size.
                  • Floating, bottom-center by default; fully adjustable via controls.
                {%- endcomment -%}
                {% if block.settings.show_caption and block.settings.caption != blank %}
                  <div class="cis__caption cis__caption--overlay"
                       style="
                         --cap-x: {{ section.settings.caption_pos_x }}%;
                         --cap-y: {{ section.settings.caption_pos_y }}%;
                         --cap-maxw: {{ section.settings.caption_max_w }}px;
                         --cap-pad-x: {{ section.settings.caption_px }}px;
                         --cap-pad-y: {{ section.settings.caption_py }}px;
                         --cap-radius: {{ section.settings.caption_radius }}px;
                         --cap-bg: {{ section.settings.caption_bg }};
                         --cap-color: {{ section.settings.caption_color }};
                       ">
                    <div class="cis__caption-inner">
                      {{ block.settings.caption }}
                    </div>
                  </div>
                {% endif %}
              </div>
            </figure>
          </div>
        {% endfor %}

        {% if section.blocks.size == 0 %}
          {% for i in (1..3) %}
            <div class="slide-item" data-carousel-slide data-item>
              <figure class="cis__card">
                <div class="cis__media"
                     style="--cis-ratio: {{ ratio_value }}; --cis-ratio-mobile: {{ mobile_ratio_value }};
                            --cis-radius: {{ section.settings.image_radius }}px;
                            --cis-maxh: {% if section.settings.max_height_px > 0 %}{{ section.settings.max_height_px }}px{% else %}none{% endif %};
                            background: {{ section.settings.placeholder_color }};"></div>
                <figcaption class="cis__caption">Add images in the editor</figcaption>
              </figure>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      {% if show_desktop_bar %}
        <div class="custom-scrollbar{% if show_mobile_bar %} medium-up--show{% else %} large-up--show{% endif %}">
          <div class="custom-scrollbar__track" data-carousel-track></div>
        </div>
      {% endif %}

      {% if show_mobile_bar %}
        <div class="custom-scrollbar small-down--show" data-custom-scrollbar>
          <div class="custom-scrollbar__track" data-custom-scrollbar-track></div>
        </div>
      {% endif %}

      {% if section.settings.show_arrows %}
        <button class="cis__nav cis__nav--prev" type="button" aria-label="Previous" data-carousel-prev>
          <svg viewBox="0 0 26 26" width="26" height="26" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 6.5" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="cis__nav cis__nav--next" type="button" aria-label="Next" data-carousel-next>
          <svg viewBox="0 0 26 26" width="26" height="26" aria-hidden="true"><path d="M9.5 6.5L15 12l-5.5 6.5" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      {% endif %}
    </flickity-carousel>

    {%- comment -%} Modal overlay for opening links in a floating window {%- endcomment -%}
    <div class="cis__modal-overlay" data-hidden="true">
      <div class="cis__modal-window" role="dialog" aria-modal="true" aria-label="Preview">
        <div class="cis__modal-header">
          <div class="cis__modal-title">Preview</div>
          <button class="cis__modal-close" type="button" aria-label="Close">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="cis__modal-content"></div>
      </div>
    </div>
  </div>

  <style>
    /* Overlay caption (positionable) */
    #img-slider-{{ section.id }} .cis__caption--overlay{
      position: absolute;
      left: var(--cap-x, 50%);
      top:  var(--cap-y, 90%);
      transform: translate(-50%, -50%);
      max-width: var(--cap-maxw, 600px);
      pointer-events: none;     /* clicks pass through unless there is a link inside */
      z-index: 2;
      text-align: center;
    }
    #img-slider-{{ section.id }} .cis__caption--overlay .cis__caption-inner{
      display: inline-block;
      padding: var(--cap-pad-y, 8px) var(--cap-pad-x, 12px);
      background: var(--cap-bg, rgba(0, 0, 0, 0));
      color: var(--cap-color, #111);
      border-radius: var(--cap-radius, 8px);
      line-height: 1.35;
      pointer-events: auto;     /* keep links in caption clickable */
      backdrop-filter: saturate(1.1) blur(0px);
    }

    /* No hard edge gutters: flush to wrapper edges */
    #img-slider-{{ section.id }} [data-carousel]{
      --grid-gutter: var(--gap-desktop);
      --grid-gutter-x: var(--gap-desktop);
      --grid-gutter-y: 0px;
      padding-inline: 0;
      display: flex;
    }
    #img-slider-{{ section.id }} [data-carousel] [data-item],
    #img-slider-{{ section.id }} .slide-item{
      padding-left: 0 !important;
      padding-right: 0 !important;
      margin-right: var(--gap-desktop) !important;
    }
    #img-slider-{{ section.id }} .slide-item:first-child{ margin-left: 0 !important; }
    #img-slider-{{ section.id }} [data-carousel]::after{ content:none; }

    /* Aspect-ratio card */
    #img-slider-{{ section.id }} .cis__media{
      position: relative; width: 100%;
      aspect-ratio: var(--cis-ratio);
      max-height: var(--cis-maxh);
      border-radius: var(--cis-radius);
      overflow: hidden;
    }
    #img-slider-{{ section.id }} .cis__imglink{ display:block; }
    #img-slider-{{ section.id }} .cis__img{ width:100%; height:100%; object-fit: {{ section.settings.image_fit }}; display:block; }
    #img-slider-{{ section.id }} .cis__placeholder{ width:100%; height:100%; background: {{ section.settings.placeholder_color }}; }

    /* Image container for iframe replacement */
    #img-slider-{{ section.id }} .cis__img-container{ position:relative; width:100%; height:100%; cursor:pointer; }
    #img-slider-{{ section.id }} .cis__img-container:not([data-iframe-url]){ cursor:default; }

    /* Modal overlay */
    #img-slider-{{ section.id }} .cis__modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 40px 24px;
      backdrop-filter: blur(4px);
    }
    #img-slider-{{ section.id }} .cis__modal-overlay[data-hidden="true"] { display: none; }

    /* Modal window */
    #img-slider-{{ section.id }} .cis__modal-window {
      position: relative;
      width: min(100%, 960px);
      height: min(80vh, 640px);
      background: #111;
      border-radius: 12px;
      box-shadow: 0 20px 48px -8px rgba(0,0,0,0.5);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(255,255,255,0.08);
    }

    /* Modal iframe container */
    #img-slider-{{ section.id }} .cis__modal-content {
      flex: 1;
      position: relative;
      background: #000;
    }
    #img-slider-{{ section.id }} .cis__modal-content iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
      background: #fff;
    }

    /* Modal header */
    #img-slider-{{ section.id }} .cis__modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: linear-gradient(to right, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
      border-bottom: 1px solid rgba(255,255,255,0.08);
      font-size: 14px;
      color: #eee;
      user-select: none;
    }
    #img-slider-{{ section.id }} .cis__modal-title { font-weight: 600; letter-spacing: .5px; }

    /* Close button */
    #img-slider-{{ section.id }} .cis__modal-close {
      background: rgba(255,255,255,0.12);
      border: 0;
      color: #fff;
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border-radius: 8px;
      transition: background .15s ease, transform .15s ease;
    }
    #img-slider-{{ section.id }} .cis__modal-close:hover { background: rgba(255,255,255,0.25); transform: scale(1.08); }
    #img-slider-{{ section.id }} .cis__modal-close:active { transform: scale(.94); }

    /* Entrance animation */
    #img-slider-{{ section.id }} .cis__modal-window { animation: cisModalIn .35s cubic-bezier(.16,.68,.43,1); }
    @keyframes cisModalIn { from { transform: translateY(24px) scale(.94); opacity:0; } to { transform: translateY(0) scale(1); opacity:1; } }

    /* Responsive tweaks */
    @media (max-width: 640px){
      #img-slider-{{ section.id }} .cis__modal-window { height: 70vh; }
      #img-slider-{{ section.id }} .cis__modal-header { padding: 8px 12px; }
      #img-slider-{{ section.id }} .cis__modal-close { width: 28px; height: 28px; }
    }

    #img-slider-{{ section.id }} .cis__caption{
      padding: {{ section.settings.caption_py }}px {{ section.settings.caption_px }}px;
      font-size: {{ section.settings.caption_size }}px;
      text-align: {{ section.settings.caption_align }};
      color: {{ section.settings.caption_color }};
      background: {{ section.settings.caption_bg }};
      border-bottom-left-radius: var(--cis-radius);
      border-bottom-right-radius: var(--cis-radius);
    }

    /* Arrow indicators */
    #img-slider-{{ section.id }} .cis__nav{
      position:absolute; top:50%; transform:translateY(-50%);
      width:44px; height:44px; border-radius:9999px;
      display:grid; place-items:center;
      background: {{ section.settings.arrows_bg }};
      color: {{ section.settings.arrows_color }};
      border: 0; cursor: pointer; opacity: .9;
      transition: opacity .2s ease, transform .2s ease, background .2s ease;
      z-index: 2;
    }
    #img-slider-{{ section.id }} .cis__nav:hover{ opacity:1; }
    #img-slider-{{ section.id }} .cis__nav--prev{ left: 8px; }
    #img-slider-{{ section.id }} .cis__nav--next{ right: 8px; }

    /* Mobile */
    @media (max-width: 990px){
      #img-slider-{{ section.id }} [data-carousel]{
        --grid-gutter: var(--gap-mobile);
        --grid-gutter-x: var(--gap-mobile);
      }
      #img-slider-{{ section.id }} [data-carousel] [data-item],
      #img-slider-{{ section.id }} .slide-item{
        margin-right: var(--gap-mobile) !important;
      }
      #img-slider-{{ section.id }} .cis__media{ aspect-ratio: var(--cis-ratio-mobile); }
      #img-slider-{{ section.id }} .cis__nav{ width:40px; height:40px; }
    }
  </style>

  <script>
    (function() {
      const root = document.querySelector('#img-slider-{{ section.id }}');
      if (!root) return;

      const overlay = root.querySelector('.cis__modal-overlay');
      const modal = root.querySelector('.cis__modal-window');
      const content = root.querySelector('.cis__modal-content');
      const closeBtn = root.querySelector('.cis__modal-close');

      function openModalWithIframe(url, title) {
        if (!overlay || !content) return;
        // Cleanup previous content
        content.innerHTML = '';
        // Create iframe
        const iframe = document.createElement('iframe');
        iframe.src = url;
        iframe.loading = 'lazy';
        iframe.allow = 'fullscreen';
        content.appendChild(iframe);
        // Title
        const titleEl = root.querySelector('.cis__modal-title');
        if (titleEl) titleEl.textContent = title || 'Preview';
        // Show overlay
        overlay.setAttribute('data-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!overlay || !content) return;
        overlay.setAttribute('data-hidden', 'true');
        // Cleanup to stop background loading
        content.innerHTML = '';
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }

      // Click on image container -> open modal (if link is present)
      root.addEventListener('click', function(e) {
        const container = e.target.closest('.cis__img-container');
        if (!container || !root.contains(container)) return;
        const iframeUrl = container.getAttribute('data-iframe-url');
        if (!iframeUrl) return; // no link -> do nothing

        // Derive a title: use caption text (stripped of HTML) or alt text
        let title = 'Preview';
        const mediaContainer = container.closest('.cis__media');
        if (mediaContainer) {
          const captionEl = mediaContainer.querySelector('.cis__caption--overlay');
          if (captionEl) {
            // Extract clean text without HTML tags
            title = captionEl.textContent.trim() || title;
          }
        }
        // Fallback to alt text if no caption
        if (title === 'Preview') {
          const img = container.querySelector('.cis__img');
          if (img && img.getAttribute('alt')) {
            title = img.getAttribute('alt');
          }
        }
        openModalWithIframe(iframeUrl, title);
      });

      // Close handlers: close button, click outside modal, Escape key
      if (closeBtn) {
        closeBtn.addEventListener('click', closeModal);
      }
      if (overlay) {
        overlay.addEventListener('click', function(e){
          if (e.target === overlay) closeModal();
        });
      }
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') closeModal();
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Crative — Image slider",
  "settings": [
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Padding top (px)", "min": 0, "max": 200, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 200, "step": 4, "default": 60 },

    { "type": "header", "content": "Caption overlay position" },
    { "type": "range",  "id": "caption_pos_x", "label": "Horizontal position (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
    { "type": "range",  "id": "caption_pos_y", "label": "Vertical position (%)",   "min": 0, "max": 100, "step": 1, "default": 90 },
    { "type": "range",  "id": "caption_max_w", "label": "Max width (px)",          "min": 120, "max": 1200, "step": 15, "default": 720 },
    { "type": "range",  "id": "caption_radius","label": "Corner radius (px)",      "min": 0, "max": 36, "step": 1, "default": 10 },

    { "type": "text", "id": "title", "label": "Title", "default": "Featured slides" },

    { "type": "select", "id": "align_text", "label": "Heading alignment", "default": "title-center",
      "options": [
        { "value": "title-left", "label": "Left" },
        { "value": "title-center", "label": "Centered" }
      ]
    },

    { "type": "select", "id": "progress_bar", "label": "Progress bar style", "default": "mobile",
      "options": [
        { "value": "hidden",  "label": "Hidden" },
        { "value": "mobile",  "label": "Mobile only" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "both",    "label": "Mobile and desktop" }
      ]
    },

    { "type": "header", "content": "Layout controls" },
    { "type": "select", "id": "width", "label": "Width", "default": "wrapper",
      "options": [
        { "value": "wrapper--full",  "label": "Full width padded" },
        { "value": "wrapper",        "label": "Page width" },
        { "value": "wrapper--narrow","label": "Page width narrow" }
      ]
    },
    { "type": "range", "id": "max_width_px", "label": "Max width (px) — 0 = no cap", "min": 0, "max": 2000, "step": 20, "default": 1400 },

    { "type": "header", "content": "Items per row" },
    { "type": "range", "id": "grid_large",  "min": 2, "max": 6, "step": 1,   "label": "Desktop", "default": 3 },
    { "type": "range", "id": "grid_medium", "min": 1, "max": 4, "step": 1,   "label": "Tablet",  "default": 2 },
    { "type": "range", "id": "grid_mobile", "min": 1, "max": 3, "step": 0.1, "label": "Mobile",  "default": 1.2 },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "item_gap_desktop",   "label": "Gap between items – desktop (px)", "min": 0, "max": 64, "step": 1, "default": 16 },
    { "type": "range", "id": "item_gap_mobile",    "label": "Gap between items – mobile (px)",  "min": 0, "max": 48, "step": 1, "default": 12 },

    { "type": "header", "content": "Section background" },
    { "type": "color", "id": "section_bg", "label": "Section background color", "default": "#ffffff" },

    { "type": "header", "content": "Aspect ratio" },
    { "type": "select", "id": "ratio", "label": "Desktop ratio", "default": "4:3",
      "options": [
        { "value": "1:1", "label": "1 : 1" },
        { "value": "4:3", "label": "4 : 3" },
        { "value": "7:5", "label": "7 : 5" },
        { "value": "16:9", "label": "16 : 9" }
      ]
    },
    { "type": "select", "id": "ratio_mobile", "label": "Mobile ratio", "default": "4:3",
      "options": [
        { "value": "1:1", "label": "1 : 1" },
        { "value": "4:3", "label": "4 : 3" },
        { "value": "7:5", "label": "7 : 5" },
        { "value": "16:9", "label": "16 : 9" }
      ]
    },
    { "type": "range", "id": "max_height_px", "label": "Max height clamp (px) — 0 = none", "min": 0, "max": 1200, "step": 100, "default": 0 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "options": [
        { "value": "cover",  "label": "Cover (crop to fill)" },
        { "value": "contain","label": "Contain (letterbox)" },
        { "value": "fill",   "label": "Fill (may distort)" }
      ]
    },
    { "type": "range", "id": "image_radius", "label": "Corner radius (px)", "min": 0, "max": 36, "step": 1, "default": 12 },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder color", "default": "#f2f2f2" },

    { "type": "header", "content": "Caption style" },
    { "type": "select", "id": "caption_align", "label": "Caption alignment", "default": "center",
      "options": [
        { "value": "left",   "label": "Left" },
